rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserSpace(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update, delete: if ownsUserSpace(userId);

      match /{document=**} {
        allow read, create, update, delete: if ownsUserSpace(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
